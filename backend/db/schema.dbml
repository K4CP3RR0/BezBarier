// BezBarier — schema 3NF (MVP) + Better Auth
//
// Auth: user / session / account / verification = Better Auth
// Domena: role (M:N), profil, bariery, STT, crowdsourcing
 // point = GEOGRAPHY(POINT,4326) w PostGIS
 // barrier_verifications ≠ verification (auth)

Enum barrier_source {
  VOICE
  MANUAL
  PHOTO
}

Enum barrier_verification_action {
  CONFIRM
  DENY
  RESOLVED
}

// ---------------------------------------------------------------------------
// Better Auth (core) — hasło w account.password
 // ---------------------------------------------------------------------------

Table user {
  id            varchar(36) [pk]
  name          varchar(255) [not null]
  email         varchar(255) [not null, unique]
  emailVerified boolean [not null, default: false]
  image         text
  createdAt     timestamptz [not null, default: `now()`]
  updatedAt     timestamptz [not null, default: `now()`]
}

Table session {
  id        varchar(36) [pk]
  expiresAt timestamptz [not null]
  token     varchar(255) [not null, unique]
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]
  ipAddress varchar(64)
  userAgent text
  userId    varchar(36) [not null, ref: > user.id]
}

Table account {
  id                    varchar(36) [pk]
  accountId             varchar(255) [not null]
  providerId            varchar(64) [not null, note: 'credential | google | …']
  userId                varchar(36) [not null, ref: > user.id]
  accessToken           text
  refreshToken          text
  idToken               text
  accessTokenExpiresAt  timestamptz
  refreshTokenExpiresAt timestamptz
  scope                 text
  password              text [note: 'hash Better Auth']
  createdAt             timestamptz [not null, default: `now()`]
  updatedAt             timestamptz [not null, default: `now()`]

  indexes {
    (providerId, accountId) [unique, note: 'jedna tożsamość providera']
  }
}

Table verification {
  id         varchar(36) [pk]
  identifier varchar(255) [not null]
  value      text [not null]
  expiresAt  timestamptz [not null]
  createdAt  timestamptz [default: `now()`]
  updatedAt  timestamptz [default: `now()`]

  Note: 'Better Auth: mail / reset hasła — nie crowdsourcing'
}

// ---------------------------------------------------------------------------
// Domena BezBarier
 // ---------------------------------------------------------------------------

Table roles {
  id uuid [pk]
  code varchar(32) [not null, unique, note: 'BLIND | WHEELCHAIR | LIMITED_MOBILITY | VOLUNTEER']
  name varchar(100) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table user_roles {
  user_id varchar(36) [not null, ref: > user.id]
  role_id uuid [not null, ref: > roles.id]
  is_primary boolean [not null, default: false, note: 'dokładnie jedna primary / user (partial UNIQUE w SQL)']
  assigned_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role_id) [pk]
  }

  Note: 'BR-001: ≥1 rola; primary steruje UI i wagami tras (RB-001)'
}

Table user_accessibility_profiles {
  user_id varchar(36) [pk, ref: - user.id]
  max_curb_height_cm smallint
  max_slope_percent numeric(4,1)
  avoid_silent_crossings boolean [not null, default: false]
  prefer_tactile_paving boolean [not null, default: false]
  notes text
  updated_at timestamptz [not null, default: `now()`]
}

Table barrier_categories {
  id uuid [pk]
  code varchar(64) [not null, unique, note: 'NO_PASSAGE | VERTICAL_OBSTACLE | DEVICE_FAILURE | MISSING_TACTILE_AUDIO']
  name varchar(120) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table barrier_statuses {
  id uuid [pk]
  code varchar(64) [not null, unique, note: 'VOICE_UNVERIFIED | CONFIRMED | RESOLVED | EXPIRED']
  name varchar(120) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table barriers {
  id uuid [pk]
  category_id uuid [not null, ref: > barrier_categories.id]
  status_id uuid [not null, ref: > barrier_statuses.id]
  reported_by_user_id varchar(36) [not null, ref: > user.id]
  description text [not null]
  location point [not null, note: 'PostGIS GEOGRAPHY(POINT,4326)']
  gps_accuracy_m numeric(6,2) [note: 'BR-020: app wymaga <= 15']
  source barrier_source [not null, default: 'VOICE']
  is_temporary boolean [not null, default: false]
  expires_at timestamptz [note: 'wymagane gdy is_temporary (CHECK w SQL)']
  confirmed_at timestamptz
  deactivated_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'BR-022 anty-duplikat 10 m: serwis (ST_DWithin); nie da się tanio zrobić UNIQUE na geography'
}

Table voice_notes {
  id uuid [pk]
  barrier_id uuid [not null, ref: > barriers.id, note: 'tworzyć w tej samej transakcji co barrier']
  user_id varchar(36) [not null, ref: > user.id]
  transcription_text text [not null]
  raw_transcript text
  audio_storage_key varchar(512)
  location point
  created_at timestamptz [not null, default: `now()`]
}

Table barrier_verifications {
  id uuid [pk]
  barrier_id uuid [not null, ref: > barriers.id]
  user_id varchar(36) [not null, ref: > user.id]
  action barrier_verification_action [not null]
  photo_storage_key varchar(512)
  note text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (barrier_id, user_id, action) [unique, note: '1 akcja danego typu / user / bariera']
  }

  Note: 'BR-014: CONFIRMED = zdjęcie LUB 2× CONFIRM — status liczy serwis'
}
